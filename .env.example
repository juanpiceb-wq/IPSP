# ---------------------------------------------------------------------------
# Planificación de Alimentación — variables de entorno
# ---------------------------------------------------------------------------
# Si estas dos variables NO están definidas, la aplicación arranca en
# MODO DEMO: usa un almacén en memoria con todos los datos del seed.
# Sirve para probar y demostrar sin instalar nada, pero los cambios se
# pierden al reiniciar el servidor.
#
# Para persistencia real, cree un proyecto en https://supabase.com,
# ejecute supabase/schema.sql y supabase/seed.sql en el SQL Editor y
# copie aquí las credenciales del proyecto (Settings → API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Roles de la beta.
# admin_general = administra, elimina menús/campamentos/zonas antes de iniciar la semana y registra cumplimiento.
# admin = administra planificación y registra cumplimiento, sin eliminaciones definitivas.
# viewer = solo lectura.
APP_ROLE=admin_general
